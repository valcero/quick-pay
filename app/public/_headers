# Cloudflare Pages response headers (also understood by Netlify).
# The encryption key lives in browser storage on web, so no third-party code may run on this origin.
# 'wasm-unsafe-eval' lets the Go core and the QR decoder compile; it does not allow eval() of JS.
# style-src 'unsafe-inline' is needed by react-native-web, which injects <style> tags at runtime.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin

/*.wasm
  Content-Type: application/wasm
